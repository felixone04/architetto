DirectoryIndex index.php
Options -Indexes

# Sempre in HTTPS (quando il dominio ha il certificato, su Hostinger è gratuito)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Mappa del sito e istruzioni per i motori di ricerca
  RewriteRule ^sitemap\.xml$ seo.php?f=sitemap [L,QSA]
  RewriteRule ^robots\.txt$ seo.php?f=robots [L,QSA]

  # Indirizzi delle pagine (/progetti/villa-le-querce, /area-clienti…): li disegna index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L]
</IfModule>

# File nascosti, backup e documentazione non si aprono dal browser
<FilesMatch "^\.|\.(md|json\.bak|sqlite|log)$">
  Require all denied
</FilesMatch>
<Files "manifest.json">
  Require all granted
</Files>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Foto, caratteri e script restano in memoria nel browser (gli indirizzi cambiano a ogni modifica)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>